; WSOCK.DLL -- Winsock: sockets over the VMM's TCP/IP stack
LIBRARY WSOCK.DLL
BASE    0x10500000
EXPORTS
    WSAStartup
    WSACleanup
    WSAGetLastError
    WSASetLastError
    socket
    bind
    connect
    listen
    accept
    send
    recv
    sendto
    recvfrom
    shutdown
    closesocket
    setsockopt
    getsockopt
    ioctlsocket
    getsockname
    getpeername
    select
    WSAPoll
    __WSAFDIsSet
    __WSAFDClr
    htons
    ntohs
    htonl
    ntohl
    inet_addr
    inet_ntoa
    inet_pton
    inet_ntop
    gethostbyname
    gethostname
    getaddrinfo
    freeaddrinfo
    GetNetworkConfig
