; KERNEL.DLL -- the userland kernel library (wraps INT 30h)
LIBRARY KERNEL.DLL
BASE    0x10000000
EXPORTS
    ExitProcess
    OutputDebugString
    DebugLog
    GetTickCount
    Sleep
    GetStartupInfo
    StartDosSession
    GetInputEvent
    WaitForInput
    HasMouse
    CreateProcess
    GetCurrentProcessId
    IsProcessAlive
    TerminateProcess
    GetProcessExitCount
    WaitForWake
    WakeProcess
    AcquireLock
    ReleaseLock
    GetLocalTime
    SetWaitHooks
    CreateFile
    ReadFile
    WriteFile
    CloseHandle
    SetFilePointer
    GetFileSize
    DeleteFile
    MoveFile
    CreateDirectory
    RemoveDirectory
    GetFileAttributes
    GetCurrentDirectory
    SetCurrentDirectory
    FindFirstFile
    FindNextFile
    FindClose
    GetLastError
    SetLastError
