    ReleaseLock
    GetLocalTime
    SetWaitHooks
    CreateFile
    ReadFile
    WriteFile
    CloseHandle
    SetFilePointer
    GetFileSize
    DeleteFile
    MoveFile
    CreateDirectory
    RemoveDirectory
    GetFileAttributes
    GetCurrentDirectory
    SetCurrentDirectory
    FindFirstFile
    FindNextFile
    FindClose
    GetLastError
    SetLastError
    LocalAlloc
    LocalReAlloc
    LocalFree
    LocalSize
    EnumProcesses
    TaskListShown
    GetDisplayInfo
    GetDisplayModes
    SetDisplayMode
    GetRandomBytes
    OpenProcess
    GetExitCodeProcess
    GetCommandLine
    GetModuleFileName
    SetEndOfFile
    FlushFileBuffers
