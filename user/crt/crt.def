; CRT.DLL -- the C runtime, shared by the programs that import it.
; (libcrt.a is the same code for linking into a module of its own.)
LIBRARY CRT.DLL
BASE    0x10400000
EXPORTS
    __crt_start
    __errno
    __crt_stdio
    __assert_fail
    ; string.h
    memcpy
    memmove
    memset
    memcmp
    memchr
    strlen
    strnlen
    strcmp
    strncmp
    strcasecmp
    strncasecmp
    strcoll
    strcpy
    strncpy
    strcat
    strncat
    strchr
    strrchr
    strstr
    strspn
    strcspn
    strpbrk
    strtok
    strtok_r
    strdup
    strndup
    strerror
    strlcpy
    strlcat
    strncpy0
    explicit_bzero
    timingsafe_memcmp
    memcpy_s
    memmove_s
    memset_s
    strcpy_s
    strncpy_s
    strcat_s
    strncat_s
    strtok_s
    strnlen_s
    strerror_s
    strerrorlen_s
    __memcpy_chk
    __memmove_chk
    __memset_chk
    __strcpy_chk
    __strncpy_chk
    __strcat_chk
    __strncat_chk
    __chk_fail
    ; stdlib.h
    malloc
    calloc
    realloc
    reallocarray
    free
    malloc_usable_size
    abort
    exit
    _Exit
    atexit
    atoi
    atol
    atoll
    strtol
    strtoul
    strtoll
    strtoull
    abs
    labs
    llabs
    div
    ldiv
    rand
    srand
    rand_s
    getrandom_bytes
    qsort
    bsearch
    qsort_s
    bsearch_s
    getenv
    getenv_s
    set_constraint_handler_s
    abort_handler_s
    ignore_handler_s
    ; stdio.h
    fopen
    fopen_s
    fclose
    fflush
    setvbuf
    fread
    fwrite
    fgetc
    getc
    getchar
    ungetc
    fgets
    gets_s
    fputc
    putc
    putchar
    fputs
    puts
    fseek
    ftell
    rewind
    fgetpos
    fsetpos
    feof
    ferror
    clearerr
    remove
    rename
    perror
    printf
    fprintf
    sprintf
    snprintf
    vprintf
    vfprintf
    vsprintf
    vsnprintf
    printf_s
    fprintf_s
    sprintf_s
    snprintf_s
    vsprintf_s
    vsnprintf_s
    __sprintf_chk
    __snprintf_chk
    __vsprintf_chk
    __vsnprintf_chk
    ; ctype.h
    isalnum
    isalpha
    isblank
    iscntrl
    isdigit
    isgraph
    islower
    isprint
    ispunct
    isspace
    isupper
    isxdigit
    tolower
    toupper
    ; setjmp.h
    setjmp
    longjmp
    ; time.h
    time
    clock
    mktime
    gmtime_r
    localtime_r
    gmtime
    localtime
    strftime
    __crt_set_output
