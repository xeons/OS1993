; UI.DLL -- windows, messages, painting and the standard controls
LIBRARY UI.DLL
BASE    0x10200000
HOOK    ui_enter            ; every call takes the window manager lock
EXPORTS
    InitUI
    RegisterClass
    CreateWindow
    DestroyWindow
    IsWindow
    GetParent
    GetDlgItem
    GetDlgCtrlID
    MoveWindow
    ShowWindow
    EnableWindow
    IsWindowEnabled
    GetClientRect
    GetWindowRect
    SetWindowText
    GetWindowText
    GetWindowLong
    SetWindowLong
    SetProp
    GetProp
    RemoveProp
    GetActiveWindow
    SetActiveWindow
    GetFocus
    SetFocus
    SetCapture
    ReleaseCapture
    GetCapture
    GetKeyState
    GetMessage
    PeekMessage
    TranslateMessage
    DispatchMessage
    SendMessage
    PostMessage
    PostQuitMessage
    DefWindowProc
    CallWindowProc
    IsDialogMessage
    SetTimer
    KillTimer
    CheckDlgButton
    IsDlgButtonChecked
    SetDlgItemText
    GetDlgItemText
    InvalidateRect
    BeginPaint
    EndPaint
    FillRect
    FrameRect
    DrawLine
    SetPixel
    TextOut
    DrawBitmap
    DrawBevel
    DrawRoundRect
    TextWidth
    CreateMenu
    CreatePopupMenu
    DestroyMenu
    AppendMenu
    SetMenu
    GetMenu
    GetSubMenu
    GetMenuItemCount
    CheckMenuItem
    EnableMenuItem
    CheckMenuRadioItem
    GetSystemMenu
    TrackPopupMenu
    DrawMenuBar
    CreateAcceleratorTable
    DestroyAcceleratorTable
    TranslateAccelerator
    MessageBox
    CreateWindowEx
    UpdateWindow
    DrawLineEx
    DrawEllipse
    DrawPixels
    EnumWindows
    FindWindow
    GetWindowProcessId
    IsWindowVisible
    IsIconic
    GetForegroundWindow
    SetForegroundWindow
    RegisterShellHookWindow
    SetShellWindow
    GetShellWindow
    SystemParametersInfo
    GetClassIcon
    SetClipboardText
    GetClipboardText
    GetClipboardTextLength
