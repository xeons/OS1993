; UI.DLL -- windows, messages, painting and the standard controls
LIBRARY UI.DLL
BASE    0x10200000
EXPORTS
    InitUI
    RegisterClass
    CreateWindow
    DestroyWindow
    IsWindow
    GetParent
    GetDlgItem
    GetDlgCtrlID
    MoveWindow
    ShowWindow
    EnableWindow
    IsWindowEnabled
    GetClientRect
    GetWindowRect
    SetWindowText
    GetWindowText
    GetWindowLong
    SetWindowLong
    SetProp
    GetProp
    RemoveProp
    GetActiveWindow
    SetActiveWindow
    GetFocus
    SetFocus
    SetCapture
    ReleaseCapture
    GetCapture
    GetKeyState
    GetMessage
    PeekMessage
    TranslateMessage
    DispatchMessage
    SendMessage
    PostMessage
    PostQuitMessage
    DefWindowProc
    CallWindowProc
    IsDialogMessage
    SetTimer
    KillTimer
    CheckDlgButton
    IsDlgButtonChecked
    SetDlgItemText
    GetDlgItemText
    InvalidateRect
    BeginPaint
    EndPaint
    FillRect
    FrameRect
    DrawLine
    SetPixel
    TextOut
    DrawBitmap
    DrawBevel
    DrawRoundRect
    TextWidth
